# --- Modèles ---
WVC_ASR_MODEL=facebook/mms-1b-all
WVC_ASR_LANG=wol

# --- Traduction : rapide (NLLB int8, le plus rapide), gemma ou nllb ---
WVC_RAPIDE_MODELE=facebook/nllb-200-distilled-600M
WVC_RAPIDE_ALLER_RETOUR=0
WVC_MT_BACKEND=gemma
WVC_GEMMA_MODEL=gemma4:e4b
WVC_OLLAMA_URL=http://127.0.0.1:11434
WVC_GEMMA_ROUNDTRIP=0      # 1 = vérification aller-retour (2× plus lent)
WVC_GEMMA_EXEMPLES=4
WVC_GEMMA_FUSION=1         # un seul appel Gemma par enregistrement
WVC_ASR_INT8=1             # int8 sur CPU : 0 = non, 1 = modèles CTC, 2 = aussi Whisper
WVC_GEMMA_TEMPERATURE=0.7
WVC_GEMMA_AUTO_PULL=1
# utilisé seulement si WVC_MT_BACKEND=nllb
WVC_MT_MODEL=facebook/nllb-200-distilled-600M
WVC_TTS_MODEL=facebook/mms-tts-fra
WVC_DEVICE=auto
WVC_MOCK_MODELS=0
WVC_PRELOAD=1

# --- Réduction d'erreurs ---
WVC_NUM_BEAMS=5
WVC_N_BEST=3
WVC_RERANK_ALPHA=0.5
WVC_PUNCT_RESTORE=1

# --- Robustesse au bruit ---
WVC_DEBRUITAGE=1.5        # 0 = off, 2.5 = fort (lieux très bruyants)
WVC_SNR_MIN_DB=10         # zones plus faibles = bruit, ignorées
WVC_ASR_CONF_MIN=0.45     # (divisé par 2 pour Whisper) segments transcrits avec moins de confiance = bruit, ignorés

# --- Seuils du score estimé ---
WVC_QUALITY_GOOD=0.70
WVC_QUALITY_POOR=0.45

# --- Sécurité et charge ---
WVC_API_KEYS=changez-moi
WVC_CORS_ORIGINS=
WVC_RATE_LIMIT_PER_MIN=30
WVC_MAX_CONCURRENT=1
WVC_MAX_QUEUE=4
WVC_MAX_AUDIO_S=120
WVC_MAX_UPLOAD_MB=10

# --- Données ---
WVC_DATA_DIR=/data
WVC_KEEP_AUDIO=1

# --- Assistant conversationnel optionnel (même Gemma) ---
WVC_LLM_ENABLED=0
# WVC_LLM_MODEL=gemma4:e4b        (par défaut : WVC_GEMMA_MODEL)
